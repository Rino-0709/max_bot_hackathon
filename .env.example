BOT_TOKEN=replace_me
DB_DRIVER=postgres
DATABASE_URL=postgres://spring_code_bot:change_me_before_deploy@127.0.0.1:55432/spring_code_passes?sslmode=disable
DATA_DIR=./data
POLICY_VERSION=hackathon-2026-05-24
METRICS_ADDR=:8080

# Optional bootstrap roles. Use MAX numeric user ids, comma-separated.
ADMIN_USER_IDS=
TECH_ADMIN_USER_IDS=

# Optional hackathon-only shortcut: /admin <code> grants admin role.
ADMIN_BOOTSTRAP_CODE=Vesna2026

# Docker Compose defaults. Change passwords before deployment.
POSTGRES_DB=spring_code_passes
POSTGRES_USER=spring_code_bot
POSTGRES_PASSWORD=change_me_before_deploy
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432
BOT_METRICS_BIND=127.0.0.1
BOT_METRICS_PORT=8080
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
