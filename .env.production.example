BOT_TOKEN=replace_me
DB_DRIVER=postgres
DATABASE_URL=postgres://spring_code_bot:replace_me@postgres:5432/spring_code_passes?sslmode=disable
DATA_DIR=/app/data
POLICY_VERSION=personal-data-v1
METRICS_ADDR=:8080

# Начальные роли. Используйте числовые MAX user id через запятую.
ADMIN_USER_IDS=
TECH_ADMIN_USER_IDS=

# Дополнительный bootstrap-код. Для продакшена оставьте пустым.
ADMIN_BOOTSTRAP_CODE=

# Настройки базы данных Docker Compose.
POSTGRES_DB=spring_code_passes
POSTGRES_USER=spring_code_bot
POSTGRES_PASSWORD=replace_me_with_long_random_password
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432

# Мониторинг по умолчанию доступен только локально на сервере.
BOT_METRICS_BIND=127.0.0.1
BOT_METRICS_PORT=8080
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me_with_long_random_password
